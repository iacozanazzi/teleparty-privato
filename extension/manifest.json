{
  "manifest_version": 3,
  "name": "Watch Party (personale)",
  "version": "0.5.1",
  "description": "Guarda Netflix e Prime Video in sincrono con gli amici. Uso personale.",
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.it/gp/video/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.amazon.es/gp/video/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.it/gp/video/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.amazon.es/gp/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.it/gp/video/*",
    "https://www.amazon.com/gp/video/*",
    "https://www.amazon.de/gp/video/*",
    "https://www.amazon.co.uk/gp/video/*",
    "https://www.amazon.fr/gp/video/*",
    "https://www.amazon.es/gp/video/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watch Party"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "video.html"
      ],
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.it/*",
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.es/*"
      ]
    }
  ]
}
